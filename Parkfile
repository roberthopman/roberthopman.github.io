ENV["RAILS_ENV"] = "production"
ENV["TZ"] = "UTC"

require "parklife/rails"
require_relative "config/environment"

Parklife.application.config.base = "https://roberthopman.com"

Parklife.application.config.on_404 = :error

# No crawl: true anywhere. config.base is roberthopman.com, so a link to
# https://roberthopman.com/effectuation-tool/ reads as internal, but that path
# is served by a sibling project repo and this app knows nothing about it.
# Crawling would 404 on a URL production serves correctly. Every route is
# listed instead, and the parity harness proves the list is complete.
Parklife.application.routes do
  root

  Post.all.each { |post| get post.url }

  # archive.md and tags.md still hold literal, unconverted Liquid ({% for
  # post in site.posts %} and friends): the dynamic post/tag listing logic
  # is Task 7's job, not this task's. Routing them now would render real,
  # wrong output (verified: Liquid syntax leaks straight into the HTML) and
  # turn them from MISSING into DIFFERING in the parity harness. Leaving
  # them unrouted keeps them MISSING, which is the expected state until
  # Task 7 replaces both with real views.
  listing_pages = %w[archive.md tags.md]
  Page.all.each { |page| get page.url unless page.url == "/" || listing_pages.include?(page.path) }
end

require "parklife/application"
Parklife::Application.prepend(Module.new do
  def build
    super
    root = Rails.application.root
    FileUtils.cp_r("#{root}/public/.", "#{root}/build")
    FileUtils.cp("#{root}/CNAME", "#{root}/build/CNAME") if File.exist?("#{root}/CNAME")
    # Parklife's own metadata directory is not a page. The Pages workflow
    # deploys with include-hidden-files: true, so leaving it here would
    # publish it at a live URL.
    FileUtils.rm_rf("#{root}/build/.parklife")
  end
end)
