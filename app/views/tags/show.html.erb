<div class="main">
  <h1>Tag: <%= @tag.name %></h1>

  <% if @tag.pages.any? %>
  <p>Pages tagged with "<%= @tag.name %>":</p>
  <ul class="post-list">
    <% @tag.pages.each do |page| %>
      <li>
        <a href="<%= page.url %>"><%= page.title %></a>
      </li>
    <% end %>
  </ul>
  <% end %>

  <% if @tag.posts.any? %>
  <p>Posts tagged with "<%= @tag.name %>":</p>
  <ul class="post-list">
    <% @tag.posts.each do |post| %>
      <li>
        <span class="post-meta"><%= post.date.strftime("%d-%m-%Y") %></span>
        <a href="<%= post.url %>"><%= post.title %></a>
        <% if post.excerpt_source.present? %>
          <% if post.front_matter["excerpt"].present? %>
            <p class="post-excerpt"><%= post.excerpt_source %></p>
          <% else %>
            <p class="post-excerpt"><%= raw post.excerpt_html %></p>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% end %>

  <p><a href="/tags/">← View all tags</a></p>
</div>
