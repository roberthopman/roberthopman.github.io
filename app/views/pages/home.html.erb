<div class="main">
  <h1 class="home-intro no-anchor">Field notes about building and maintaining B2B technology by Robert, <a href="/author/">say hello</a>.</h1>
  <br>

  <% @posts.each do |post| %>
  <div class='post-row'>
    <div class='column-date'><%= post.date.strftime("%d-%m-%Y") %></div>
    <div class='column-title'><a href="<%= post.url %>"><%= post.title %></a></div>
  </div>
  <% end %>

  <br>
  <div><a href="/archive/">Archive</a></div>
</div>
