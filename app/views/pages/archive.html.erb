<div class="main">

  <p class="archive-filters">
    <span class="filter-label">Words:</span>
    <a class="filter-btn<%= " active" if @range == "all" %>" href="/archive/">All</a>
    <% WordRangesController::RANGES.each do |slug, (label, _words)| %>
    <a class="filter-btn<%= " active" if @range == slug %>" href="/archive/<%= slug %>/"><%= label %></a>
    <% end %>
  </p>

  <% @posts.each do |post| %>
  <div class='post-row'>
    <div class='column-date'><%= post.date.strftime("%d-%m-%Y") %></div>
    <div class='column-title'><a href="<%= post.url %>"><%= post.title %></a></div>
  </div>
  <% end %>

  <% @tagged_pages.each do |page| %>
  <div class='post-row'>
    <div class='column-date'><%= page.last_modified_raw %></div>
    <div class='column-title'><a href="<%= page.url %>"><%= page.title %></a></div>
  </div>
  <% end %>

  <% unless @range == "all" %>
  <p class="filter-count"><%= @posts.size %> of <%= Post.all.size %> posts</p>
  <% end %>
</div>

<p><a href="/">Home</a></p>
